    {
      "id": "WkzpJXAUB1-N4rg0GUXXr",
      "type": "text",
      "x": 126.05546672165866,
      "y": 190.08240057741585,
      "width": 1355.339111328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FGN8evVQ6_4jVosTyyItM"
      ],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 2096018716,
      "version": 888,
      "versionNonce": 999027740,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784801753287,
      "link": null,
      "locked": false,
      "text": "I have been applying to jobs from different platforms like Linkedln, Xing, Stepstone, Indeed etc but I could not track my job applications\nat all, It was hard to actually identify whether i have applied, got called for first chat / assessment / interview , or rejected because \nthe Titlte + subject were pretty similar in all emails like Thankyou for applying.\nSo i thought it would be great to get all job applications in one place and identify which phase they are in and ofcourse i should not do it\nManually myself but someone does it for me like LLMs. ApplySync came through that idea.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I have been applying to jobs from different platforms like Linkedln, Xing, Stepstone, Indeed etc but I could not track my job applications\nat all, It was hard to actually identify whether i have applied, got called for first chat / assessment / interview , or rejected because \nthe Titlte + subject were pretty similar in all emails like Thankyou for applying.\nSo i thought it would be great to get all job applications in one place and identify which phase they are in and ofcourse i should not do it\nManually myself but someone does it for me like LLMs. ApplySync came through that idea.",
      "autoResize": true,
      "lineHeight": 1.25
    },
